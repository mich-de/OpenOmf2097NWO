+// PILOTS.EXT, written by tools/web/pilots (values little endian):
+//   "OMFPIL" 0 1, u8 pilot count, then per pilot:
+//   u8 pilot id, u8 color count (up to 64), RGB each,
+//   the big face then the icon: u16 width, u16 height, u8 per pixel (0 transparent,
+//   1.. the pilot's colors)
+#define PICTURE_COLORS 64
+
+typedef struct {
+    int w, h;
+    uint8_t *px;
+} picture;
+
+typedef struct {
+    int color_count;
+    vga_color colors[PICTURE_COLORS];
+    picture face, icon;
+} pilot_pictures;
+
+static pilot_pictures extra_pictures[NUMBER_OF_PILOT_TYPES];
+static bool extra_pictures_tried = false;
+
+static bool picture_read(picture *pic, sd_reader *r) {
+    pic->w = sd_read_uword(r);
+    pic->h = sd_read_uword(r);
+    pic->px = omf_calloc(pic->w * pic->h + 1, 1);
+    return sd_read_buf(r, (char *)pic->px, pic->w * pic->h) == 1;
+}
+
+static const pilot_pictures *pictures_get(int pilot_id) {
+    if(!extra_pictures_tried) {
+        extra_pictures_tried = true;
+        path filename = get_resource_filename("PILOTS.EXT");
+        sd_reader *r = sd_reader_open(&filename);
+        char magic[8];
+        if(r && sd_read_buf(r, magic, 8) == 1 && memcmp(magic, "OMFPIL\0\1", 8) == 0) {
+            int count = sd_read_ubyte(r);
+            for(int n = 0; n < count && sd_reader_ok(r); n++) {
+                int id = sd_read_ubyte(r);
+                pilot_pictures tmp = {0};
+                tmp.color_count = min2(sd_read_ubyte(r), PICTURE_COLORS);
+                for(int i = 0; i < tmp.color_count; i++) {
+                    tmp.colors[i].r = sd_read_ubyte(r);
+                    tmp.colors[i].g = sd_read_ubyte(r);
+                    tmp.colors[i].b = sd_read_ubyte(r);
+                }
+                if(picture_read(&tmp.face, r) && picture_read(&tmp.icon, r) && id < NUMBER_OF_PILOT_TYPES) {
+                    extra_pictures[id] = tmp;
+                }
+            }
+        } else if(r) {
+            log_error("Invalid pilot pictures file %s", path_c(&filename));
+        }
+        if(r) {
+            sd_reader_close(r);
+        }
+    }
+    return pilot_id >= 0 && pilot_id < NUMBER_OF_PILOT_TYPES && extra_pictures[pilot_id].color_count
+               ? &extra_pictures[pilot_id]
+               : NULL;
+}
+
+// The block of 64 entries a pilot's pictures use in the menus, and its darker copy's.
+static int menu_block(int pilot_id) {
+    return PILOT_PORTRAIT_BASE + HAR_EXTENDED_STRIDE * ((pilot_id - PILOT_TRUMP) & 1);
+}
+
+static int dim_block(int pilot_id) {
+    return HAR_EXTENDED_BASE + 1 + PICTURE_COLORS * (pilot_id - PILOT_TRUMP);
+}
+
+// A surface with the picture's pixels as entries from `base` on.
+static void picture_to_surface(surface *sur, const picture *pic, int base) {
+    if(sur->w != pic->w || sur->h != pic->h) {
+        omf_free(sur->data);
+        sur->data = omf_calloc(pic->w * pic->h, sizeof(vga_pixel));
+        sur->w = sur->render_w = pic->w;
+        sur->h = sur->render_h = pic->h;
+    }
+    for(int i = 0; i < pic->w * pic->h; i++) {
+        sur->data[i] = pic->px[i] ? base + pic->px[i] - 1 : 0;
+    }
+    sur->transparent = 0;
+}
+
+void pilot_pictures_load_colors(void) {
+    for(int id = PILOT_TRUMP; id < NUMBER_OF_PILOT_TYPES; id++) {
+        const pilot_pictures *pics = pictures_get(id);
+        if(!pics) {
+            continue;
+        }
+        vga_state_set_base_palette_range(menu_block(id), pics->color_count, (vga_color *)pics->colors);
+        vga_color dim[PICTURE_COLORS];
+        for(int i = 0; i < pics->color_count; i++) {
+            dim[i] = (vga_color){pics->colors[i].r / 2, pics->colors[i].g / 2, pics->colors[i].b / 2};
+        }
+        vga_state_set_base_palette_range(dim_block(id), pics->color_count, dim);
+    }
+}
+
+void pilot_pictures_apply(animation *faces, animation *icons) {
+    for(int id = PILOT_TRUMP; id < NUMBER_OF_PILOT_TYPES; id++) {
+        const pilot_pictures *pics = pictures_get(id);
+        sprite *face = faces ? animation_get_sprite(faces, id) : NULL;
+        sprite *icon = icons ? animation_get_sprite(icons, id) : NULL;
+        if(pics && face) {
+            picture_to_surface(face->data, &pics->face, menu_block(id));
+        }
+        if(pics && icon) {
+            picture_to_surface(icon->data, &pics->icon, menu_block(id));
+        }
+    }
+    pilot_pictures_load_colors();
+}
+
+void pilot_pictures_dim(surface *icon) {
+    for(int id = PILOT_TRUMP; id < NUMBER_OF_PILOT_TYPES; id++) {
+        int from = menu_block(id), to = dim_block(id);
+        for(int i = 0; i < icon->w * icon->h; i++) {
+            if(icon->data[i] >= from && icon->data[i] < from + PICTURE_COLORS) {
+                icon->data[i] = to + icon->data[i] - from;
+            }
+        }
+    }
+}
+
+sprite *pilot_portrait_create(int pilot_id, int player) {
+    const pilot_pictures *pics = pictures_get(pilot_id);
+    if(pics) {
+        const int base = PILOT_PORTRAIT_BASE + HAR_EXTENDED_STRIDE * player;
+        vga_state_set_base_palette_range(base, pics->color_count, (vga_color *)pics->colors);
+        surface *sur = omf_calloc(1, sizeof(surface));
+        surface_create(sur, pics->face.w, pics->face.h);
+        picture_to_surface(sur, &pics->face, base);
+        sprite *result = omf_calloc(1, sizeof(sprite));
+        sprite_create_custom(result, vec2i_create(0, 0), sur);
+        result->owned = true;
+        return result;
+    }
+    path filename = get_resource_filename(get_resource_file(BK_MELEE));
+    sd_bk_file bk;
+    sd_bk_create(&bk);
+    sprite *result = NULL;
+    sd_bk_anim *faces = sd_bk_load(&bk, &filename) == SD_SUCCESS ? sd_bk_get_anim(&bk, 4) : NULL;
+    sd_sprite *face = faces ? sd_animation_get_sprite(faces->animation, pilot_id) : NULL;
+    if(face && face->len > 0) {
+        sd_vga_image img;
+        sd_sprite_vga_decode(&img, face);
+        // each color the face uses gets one of the player's portrait entries
+        int map[256] = {0};
+        int used = 0;
+        const int base = PILOT_PORTRAIT_BASE + HAR_EXTENDED_STRIDE * player;
+        surface *sur = omf_calloc(1, sizeof(surface));
+        surface_create(sur, img.w, img.h);
+        for(unsigned i = 0; i < img.w * img.h; i++) {
+            uint8_t c = img.data[i];
+            if(c == 0) {
+                continue;
+            }
+            if(!map[c] && used < PILOT_PORTRAIT_COLORS) {
+                map[c] = base + used++;
+                vga_state_set_base_palette_index(map[c], &bk.palettes[0]->colors[c]);
+            }
+            sur->data[i] = map[c] ? map[c] : base; // more colors than room: unlikely, keep the first
+        }
+        sd_vga_image_free(&img);
+        result = omf_calloc(1, sizeof(sprite));
+        sprite_create_custom(result, vec2i_create(0, 0), sur);
+        result->owned = true;
+    }
+    sd_bk_free(&bk);
+    return result;
+}
+
 void har_load_player_colors(const vga_palette *pilot_colors, unsigned int har_id, int player) {
     palette_load_player_colors(pilot_colors, player);
     int count;

+// The pilot grid, six columns like the robots': the original ten icons narrowed around
+// their middle, Trump and Musk in the sixth column, and the panel of unselected ones.
+static void load_pilot_portraits(scene *scene, melee_local *local) {
+    animation *icons = &bk_get_info(scene->bk_data, 3)->ani;
+    for(int i = 0; i < NUMBER_OF_PILOT_TYPES; i++) {
+        sprite *current = i == PILOT_KREISSACK ? NULL : animation_get_sprite(icons, i);
+        if(current == NULL) {
+            continue;
+        }
+        portrait *target = &local->pilot_portraits[i];
+        int col = i >= PILOT_TRUMP ? EXTRA_COLUMN : i % 5;
+        int row = i >= PILOT_TRUMP ? i - PILOT_TRUMP : i / 5;
+        target->x = HAR_CELL_X(col);
+        target->y = HAR_CELL_Y(row);
+
+        // Copy the face image in full color (shown when selected), centered in the narrower cell
+        const surface *icon = current->data;
+        surface_create(&target->enabled, HAR_CELL_W, 36);
+        surface_set_transparency(&target->enabled, icon->transparent);
+        int dx = (icon->w - HAR_CELL_W) / 2;
+        for(int y = 0; y < 36 && y < icon->h; y++) {
+            for(int x = 0; x < HAR_CELL_W; x++) {
+                int sx = x + dx;
+                target->enabled.data[y * HAR_CELL_W + x] =
+                    sx >= 0 && sx < icon->w ? icon->data[y * icon->w + sx] : icon->transparent;
             }
         }
+
+        // Copy the face image in dimmed color (shown when not selected)
+        surface_create_from(&target->disabled, &target->enabled);
+        if(i >= PILOT_TRUMP) {
+            pilot_pictures_dim(&target->disabled);
+        } else {
+            surface_compress_index_blocks(&target->disabled, 0x60, 0xA0, 64, 16);
+            surface_compress_index_blocks(&target->disabled, 0xA0, 0xD0, 8, 3);
+            surface_compress_index_blocks(&target->disabled, 0xD0, 0xE0, 16, 3);
+            surface_compress_index_blocks(&target->disabled, 0xE0, 0xF0, 8, 2);
+            surface_compress_remap(&target->disabled, 0xF0, 0xF7, 0xB6, 3);
+        }
+    }
+
+    // the unselected icons: the original sheet (dimmed by the palette), re-cut to six columns
+    const surface *bg = &scene->bk_data->background;
+    const sprite *sheet = animation_get_sprite(&bk_get_info(scene->bk_data, 0)->ani, 0);
+    surface_create(&local->pilot_panel, 320, 200 - PILOT_PANEL_Y);
+    surface_set_transparency(&local->pilot_panel, -1);
+    for(int y = 0; y < local->pilot_panel.h; y++) {
+        for(int x = 0; x < 320; x++) {
+            local->pilot_panel.data[y * 320 + x] = bg->data[(PILOT_PANEL_Y + y) * bg->w + har_panel_source_x(x)];
+        }
+    }
+    for(int i = 0; i < 10; i++) {
+        surface cell;
+        surface_create_from_surface(&cell, HAR_CELL_W, 36, 62 * (i % 5) + 2, 42 * (i / 5), sheet->data);
+        surface_set_transparency(&cell, -1);
+        blit_opaque(&local->pilot_panel, &cell, HAR_CELL_X(i % 5), HAR_CELL_Y(i / 5) - PILOT_PANEL_Y);
+        surface_free(&cell);
+    }
+    for(int i = PILOT_TRUMP; i < NUMBER_OF_PILOT_TYPES; i++) {
+        portrait *target = &local->pilot_portraits[i];
+        if(target->disabled.data) {
+            blit_opaque(&local->pilot_panel, &target->disabled, target->x, target->y - PILOT_PANEL_Y);
+        }
     }
 }
 

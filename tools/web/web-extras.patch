+// Keys pressed since the last game tick. The game reads the keys' state once per tick, so
+// without this a press and release between two ticks (a quick tap on a slow device, or the
+// touch pad's buttons) would never be seen.
+static bool latched[SDL_NUM_SCANCODES];
+
+void keyboard_latch_press(SDL_Scancode sc) {
+    if(sc >= 0 && sc < SDL_NUM_SCANCODES) {
+        latched[sc] = true;
+    }
+}
+
+void keyboard_latch_clear(void) {
+    memset(latched, 0, sizeof(latched));
+}
+
+// Down now, or pressed since the last tick.
+static inline bool key_down(const unsigned char *state, SDL_Scancode sc) {
+    return state[sc] || latched[sc];
+}
+
 static inline void keyboard_cmd(controller *ctrl, int action, ctrl_event **ev) {
     controller_cmd(ctrl, action, ev);
 }

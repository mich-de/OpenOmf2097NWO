+}
+
+const char *pilot_get_lang_bio(unsigned int id) {
+    return id >= PILOT_TRUMP && id < NUMBER_OF_PILOT_TYPES ? EXTRA_PILOT(id)->bio : lang_get(135 + id);
+}
+
+// What the speaker says to the target in the VS screen: the opening line, or the reply.
+const char *pilot_get_vs_line(unsigned int speaker, unsigned int target, bool reply) {
+    if(speaker >= PILOT_TRUMP) {
+        return EXTRA_PILOT(speaker)->says[reply];
+    }
+    if(target >= PILOT_TRUMP) {
+        return EXTRA_PILOT(target)->taunted[reply];
+    }
+    return lang_get((reply ? 870 : 749) + 11 * speaker + target);
+}
+
+// The ending texts: part 1 with the pilot's face, part 2 after it.
+const char *pilot_get_ending_text(unsigned int id, int part) {
+    if(id >= PILOT_TRUMP && id < NUMBER_OF_PILOT_TYPES) {
+        return EXTRA_PILOT(id)->ending[part == 1 ? 0 : 1];
+    }
+    return lang_get((part == 1 ? 993 : 1003) + id);
+}
+
+// Single player: the pilots to beat before Kreissack, as sp_wins bits (2 << pilot).
+unsigned int pilot_single_player_opponents(void) {
+    unsigned int mask = 0;
+    for(int id = 0; id < NUMBER_OF_PILOT_TYPES; id++) {
+        if(id != PILOT_KREISSACK) {
+            mask |= 2u << id;
+        }
+    }
+    return mask;
+}
+
+// A random pilot not yet beaten, other than the player's own; -1 when none is left.
+int pilot_pick_single_player_opponent(int self, unsigned int wins) {
+    int left[NUMBER_OF_PILOT_TYPES], count = 0;
+    for(int id = 0; id < NUMBER_OF_PILOT_TYPES; id++) {
+        if(id != PILOT_KREISSACK && id != self && !((2u << id) & wins)) {
+            left[count++] = id;
+        }
+    }
+    return count ? left[rand_int(count)] : -1;
+}

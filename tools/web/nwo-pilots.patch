+    const pilot_pictures *pics = pictures_get(pilot_id);
+    if(!pics) {
+        return;
+    }
+    vga_pixel map[PICTURE_COLORS + 1] = {0};
+    for(int k = 0; k < pics->color_count; k++) {
+        int r = pics->colors[k].r * brightness, g = pics->colors[k].g * brightness, b = pics->colors[k].b * brightness;
+        int best = first, best_d = 1 << 30;
+        for(int i = first; i <= last; i++) {
+            int dr = pal->colors[i].r - r, dg = pal->colors[i].g - g, db = pal->colors[i].b - b;
+            int d = 3 * dr * dr + 4 * dg * dg + 2 * db * db;
+            if(d < best_d) {
+                best_d = d;
+                best = i;
             }
         }
+        map[k + 1] = best;
+    }
+    const picture *pic = &pics->icon;
+    picture_to_surface(sur, pic, 0);
+    for(int i = 0; i < pic->w * pic->h; i++) {
+        sur->data[i] = map[pic->px[i]];
     }
 }
 

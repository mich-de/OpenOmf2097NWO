+int nwo_pilot_id(int position) {
+    return position < PILOT_KREISSACK ? position : position + 1;
+}
+
+int nwo_pilot_position(int pilot_id) {
+    return pilot_id < PILOT_KREISSACK ? pilot_id : pilot_id - 1;
+}
+
+const nwo_pilot *nwo_pilot_get(int pilot_id) {
+    if(pilot_id < 0 || pilot_id == PILOT_KREISSACK || pilot_id >= NUMBER_OF_PILOT_TYPES) {
+        return NULL;
+    }
+    return &pilots[nwo_pilot_position(pilot_id)];
+}
diff --git a/src/game/nwo_pilots.h b/src/game/nwo_pilots.h

@@ -0,0 +1,27 @@
+#ifndef NWO_PILOTS_H
+#define NWO_PILOTS_H
+
+// OpenOMF 2097 NWO: the 24 pilots, see nwo_pilots.c.
+#define NWO_PILOTS 24
+#define NWO_PILOTS_PER_PAGE 12
+
+typedef struct {
+    const char *name;     // as the texts spell it
+    const char *upper;    // as the score board spells it
+    const char *bio;
+    const char *says[2];  // in the VS screen: opening line, reply
+    const char *ending[2];
+    int sex;
+    int power, agility, endurance;
+    int colors[3];        // ALTPALS ramps: primary, secondary, tertiary
+    int ai_style;
+} nwo_pilot;
+
+// The pilot id at a position of the select grid (0..23), and back. Id 10 is Kreissack.
+int nwo_pilot_id(int position);
+int nwo_pilot_position(int pilot_id);
+
+// NULL for Kreissack.
+const nwo_pilot *nwo_pilot_get(int pilot_id);
+
+#endif // NWO_PILOTS_H

diff --git a/src/game/utils/har_extended.c b/src/game/utils/har_extended.c
new file mode 100644
index 00000000..5bd5185f
--- /dev/null
+++ b/src/game/utils/har_extended.c
@@ -0,0 +1,147 @@
+#include "game/utils/har_extended.h"
+#include "formats/internal/reader.h"
+#include "formats/palette.h"
+#include "game/common_defines.h"
+#include "resources/animation.h"
+#include "resources/ids.h"
+#include "resources/resource_files.h"
+#include "resources/sprite.h"
+#include "utils/allocator.h"
+#include "utils/log.h"
+#include "video/vga_state.h"
+#include <string.h>
+
+// <AF name>.X16, written by tools/web/ocelot (all values little endian):
+//   "OMFX16" 0 1                  magic, version
+//   u16 color count, then RGB     the colors of pixels 257, 258, ...
+//   u16 frame count, then frames: u8 move, u8 sprite, u16 width, u16 height,
+//                                 runs of (u16 transparent pixels, u16 n, n u16 pixels)
+//                                 until width * height pixels are covered
+// Pixel values below 256 keep meaning the shared palette (effects, the fire).
+
+typedef struct {
+    uint8_t move;
+    uint8_t sprite;
+    uint16_t w;
+    uint16_t h;
+    vga_pixel *pixels;
+} x16_frame;
+
+typedef struct {
+    bool tried;
+    int color_count;
+    vga_color colors[HAR_EXTENDED_COLORS];
+    int frame_count;
+    x16_frame *frames;
+} x16_file;
+
+static x16_file x16_files[NUMBER_OF_HAR_TYPES];
+
+static bool x16_read(x16_file *x16, sd_reader *r) {
+    char magic[8];
+    if(sd_read_buf(r, magic, 8) != 1 || memcmp(magic, "OMFX16\0\1", 8) != 0) {
+        return false;
+    }
+    x16->color_count = sd_read_uword(r);
+    if(x16->color_count > HAR_EXTENDED_COLORS) {
+        return false;
+    }
+    for(int i = 0; i < x16->color_count; i++) {
+        x16->colors[i].r = sd_read_ubyte(r);
+        x16->colors[i].g = sd_read_ubyte(r);
+        x16->colors[i].b = sd_read_ubyte(r);
+    }
+    x16->frame_count = sd_read_uword(r);
+    x16->frames = omf_calloc(x16->frame_count, sizeof(x16_frame));
+    for(int f = 0; f < x16->frame_count; f++) {
+        x16_frame *frame = &x16->frames[f];
+        frame->move = sd_read_ubyte(r);
+        frame->sprite = sd_read_ubyte(r);
+        frame->w = sd_read_uword(r);
+        frame->h = sd_read_uword(r);
+        int size = frame->w * frame->h;
+        frame->pixels = omf_calloc(size, sizeof(vga_pixel));
+        for(int at = 0; at < size && sd_reader_ok(r);) {
+            at += sd_read_uword(r);
+            int n = sd_read_uword(r);
+            for(int k = 0; k < n && at < size; k++) {
+                vga_pixel v = sd_read_uword(r);
+                frame->pixels[at++] = v < VGA_PALETTE_SIZE ? v : 0;
+            }
+        }
+    }
+    return sd_reader_ok(r);
+}
+
+static const x16_file *x16_get(unsigned int har_id) {
+    if(har_id >= NUMBER_OF_HAR_TYPES || sizeof(vga_pixel) < 2) {
+        return NULL;
+    }
+    x16_file *x16 = &x16_files[har_id];
+    if(!x16->tried) {
+        x16->tried = true;
+        // FIGHTR11.AF -> FIGHTR11.X16
+        char name[32];
+        snprintf(name, sizeof(name), "%s", get_resource_file(har_to_resource(har_id)));
+        char *dot = strrchr(name, '.');
+        if(dot) {
+            snprintf(dot, sizeof(name) - (dot - name), ".X16");
+        }
+        path filename = get_resource_filename(name);
+        sd_reader *r = sd_reader_open(&filename);
+        if(r) {
+            if(!x16_read(x16, r)) {
+                log_error("Invalid extended colors file %s", path_c(&filename));
+                x16->color_count = 0;
+                x16->frame_count = 0;
+            }
+            sd_reader_close(r);
+        }
+    }
+    return x16->color_count ? x16 : NULL;
+}
+
+const vga_color *har_extended_colors(unsigned int har_id, int *count) {
+    const x16_file *x16 = x16_get(har_id);
+    *count = x16 ? x16->color_count : 0;
+    return x16 ? x16->colors : NULL;
+}
+
+void har_extended_load_sprites(af *af_data, unsigned int har_id) {
+    const x16_file *x16 = x16_get(har_id);
+    if(!x16) {
+        return;
+    }
+    for(int f = 0; f < x16->frame_count; f++) {
+        const x16_frame *frame = &x16->frames[f];
+        af_move *move = af_get_move(af_data, frame->move);
+        sprite *sp = move ? animation_get_sprite(&move->ani, frame->sprite) : NULL;
+        if(!sp || !sp->owned) { // references share another sprite's pixels
+            continue;
+        }
+        if(sp->data->w != frame->w || sp->data->h != frame->h) {
+            log_error("%s: sprite %d/%d is %dx%d, its extended pixels %dx%d", har_get_name(har_id), frame->move,
+                      frame->sprite, sp->data->w, sp->data->h, frame->w, frame->h);
+            continue;
+        }
+        memcpy(sp->data->data, frame->pixels, frame->w * frame->h * sizeof(vga_pixel));
+    }
+}
+
+void har_extended_shift_surface(surface *sur) {
+    for(int i = 0; i < sur->w * sur->h; i++) {
+        if(sur->data[i] > 0 && sur->data[i] < 160) {
+            sur->data[i] += HAR_EXTENDED_BASE;
+        }
+    }
+}
+
+void har_load_player_colors(const vga_palette *pilot_colors, unsigned int har_id, int player) {
+    palette_load_player_colors(pilot_colors, player);
+    int count;
+    const vga_color *colors = har_extended_colors(har_id, &count);
+    if(colors) {
+        vga_state_set_base_palette_range(HAR_EXTENDED_BASE + 1 + HAR_EXTENDED_STRIDE * player, count,
+                                         (vga_color *)colors);
+    }
+}
diff --git a/src/game/utils/har_extended.h b/src/game/utils/har_extended.h
new file mode 100644
index 00000000..e5fb6561
--- /dev/null
+++ b/src/game/utils/har_extended.h
@@ -0,0 +1,29 @@
+#ifndef HAR_EXTENDED_H
+#define HAR_EXTENDED_H
+
+#include "resources/af.h"
+#include "video/surface.h"
+#include "video/vga_palette.h"
+
+// A HAR may bring more colors than the pilot's 47: up to 383 per player, in the extended
+// palette above the original game's 256. Player 1's live at 257..639 and player 2's at
+// 641..1023. Sprites always use player 1's; the palette shader moves them for player 2's
+// objects (palette offset 48 means +384 there), as it moves the pilot's ramps.
+#define HAR_EXTENDED_BASE 256
+#define HAR_EXTENDED_STRIDE 384
+#define HAR_EXTENDED_COLORS 383
+
+// The HAR's extended colors, from its <AF name>.X16 file; NULL and 0 when it has none.
+const vga_color *har_extended_colors(unsigned int har_id, int *count);
+
+// Replaces the HAR's sprite pixels with the 16-bit ones in its .X16 file, if it has one.
+void har_extended_load_sprites(af *af_data, unsigned int har_id);
+
+// An 8-bit sprite drawn in a HAR's first 159 extended colors (bytes 1..159), such as its
+// portrait in VS.BK: moves those bytes to the extended palette.
+void har_extended_shift_surface(surface *sur);
+
+// Loads the pilot's colors, and the HAR's extended colors, into the player's palette ranges.
+void har_load_player_colors(const vga_palette *pilot_colors, unsigned int har_id, int player);
+
+#endif // HAR_EXTENDED_H

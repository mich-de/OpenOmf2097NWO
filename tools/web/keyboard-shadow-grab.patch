+// Web build: a shadow's grab (Shadow's projectiles) holds its victim for the move's throw duration
+// as a throw does, and frozen too: no input, no animation, until it lets go. A throw's victim
+// plays the thrower's animation instead, so throws only set throw_duration.
+static void har_shadow_hold(object *o_har, int ticks) {
+    har *h = object_get_userdata(o_har);
+    h->throw_duration = ticks;
+    object_set_halt_ticks(o_har, ticks);
+}

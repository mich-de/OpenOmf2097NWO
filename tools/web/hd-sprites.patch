+// One Scale2x pass: each pixel becomes 2x2, corners taking a neighbour's value where two
+// neighbours agree, so diagonal edges step by half a pixel instead of a whole one.
+static vga_pixel *scale2x(const vga_pixel *src, int w, int h) {
+    vga_pixel *dst = omf_calloc(w * h * 4, sizeof(vga_pixel));
+    for(int y = 0; y < h; y++) {
+        for(int x = 0; x < w; x++) {
+            const vga_pixel p = src[y * w + x];
+            const vga_pixel a = y > 0 ? src[(y - 1) * w + x] : p;     // up
+            const vga_pixel b = x < w - 1 ? src[y * w + x + 1] : p; // right
+            const vga_pixel c = x > 0 ? src[y * w + x - 1] : p;     // left
+            const vga_pixel d = y < h - 1 ? src[(y + 1) * w + x] : p; // down
+            vga_pixel *out = &dst[(y * 2) * (w * 2) + x * 2];
+            out[0] = (c == a && c != d && a != b) ? a : p;
+            out[1] = (a == b && a != c && b != d) ? b : p;
+            out[w * 2] = (d == c && d != b && c != a) ? c : p;
+            out[w * 2 + 1] = (b == d && b != a && d != c) ? d : p;
+        }
+    }
+    return dst;
+}
+
+void surface_upscale_pixelart(surface *sur, int factor) {
+    for(int f = 1; f < factor; f *= 2) {
+        vga_pixel *bigger = scale2x(sur->data, sur->w, sur->h);
+        omf_free(sur->data);
+        sur->data = bigger;
+        sur->w *= 2;
+        sur->h *= 2;
+    }
+    sur->guid = guid++;
+}

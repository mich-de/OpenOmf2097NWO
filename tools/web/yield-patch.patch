@@ -195,6 +199,30 @@ void video_render_prepare(unsigned framebuffer_options) {
 
 void video_render_finish(void) {
     current_renderer.render_finish(current_renderer.ctx);
+#ifdef __EMSCRIPTEN__
+    // Web build: WebGL cannot block in SwapBuffers the way vsync does on the
+    // desktop, so pace to 60 Hz ourselves and suspend (ASYNCIFY) every frame:
+    // that lets the browser present the frame, dispatch input events and run
+    // timers. Without this the game loop starves the browser's main thread
+    // completely (emscripten's SDL_Delay only busy-waits in single-thread
+    // builds, so it is no substitute for the suspend below).
+    static double next_frame_ms = 0;
+    double now_ms = emscripten_get_now();
+    if(next_frame_ms == 0) {
+        next_frame_ms = now_ms;
+    }
+    next_frame_ms += 1000.0 / 60.0;
+    double remain_ms = next_frame_ms - now_ms;
+    if(remain_ms >= 1) {
+        emscripten_sleep(remain_ms);
+    } else {
+        // Late (or early): yield once either way, resync after a big stall.
+        emscripten_sleep(1);
+        if(remain_ms < -100.0) {
+            next_frame_ms = now_ms;
+        }
+    }
+#endif
 }
 

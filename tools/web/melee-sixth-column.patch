+// Background x for robot panel x: keeps each cell's and gap's edges, drops their middles.
+static int har_panel_source_x(int x) {
+    if(x < HAR_CELL_X(0)) {
+        return x < 4 ? x : x + 4; // left margin, 11px -> 7px
+    }
+    if(x >= HAR_CELL_X(EXTRA_COLUMN) + HAR_CELL_W) {
+        int m = x - (HAR_CELL_X(EXTRA_COLUMN) + HAR_CELL_W);
+        return 310 + (m < 4 ? m : m + 3); // right margin, 10px -> 7px
+    }
+    int column = (x - HAR_CELL_X(0)) / 52;
+    int offset = (x - HAR_CELL_X(0)) % 52;
+    if(offset < HAR_CELL_W) {
+        int src = column < 5 ? column : 4; // cell, 51px -> 46px
+        return 11 + 62 * src + (offset < HAR_CELL_W / 2 ? offset : offset + 5);
+    }
+    int gap = offset - HAR_CELL_W;
+    int src = column < 4 ? column : 3; // gap, 11px -> 6px
+    return 62 + 62 * src + (gap < 3 ? gap : gap + 5);
+}
+
+static void blit_opaque(surface *dst, const surface *src, int x, int y) {
+    for(int sy = 0; sy < src->h; sy++) {
+        for(int sx = 0; sx < src->w; sx++) {
+            vga_pixel px = src->data[sy * src->w + sx];
+            if(px != src->transparent) {
+                dst->data[(y + sy) * dst->w + x + sx] = px;
+            }
+        }
+    }
+}
+
+// Portrait for a HAR that MELEE.BK has no art for: its idle frame, shrunk into the cell.
+static void load_af_portrait(melee_local *local, int har_id, vga_pixel cell_color) {
+    portrait *target = &local->har_portraits[har_id];
+    target->x = HAR_CELL_X(EXTRA_COLUMN);
+    target->y = HAR_CELL_Y(har_id - HAR_NOVA);
+    surface_create(&target->enabled, HAR_CELL_W, 36);
+    for(int i = 0; i < HAR_CELL_W * 36; i++) {
+        target->enabled.data[i] = cell_color;
+    }
+    surface_set_transparency(&target->enabled, cell_color);
+
+    const surface *frame =
+        animation_get_sprite(&af_get_move(&local->extra_af[har_id - HAR_NOVA], ANIM_IDLE)->ani, 0)->data;
+    // fit the height; a robot too wide for the cell (Ocelot's tail) keeps its front, facing right
+    float scale = 36.0f / frame->h;
+    int w = frame->w * scale;
+    int h = frame->h * scale;
+    int ox = w <= HAR_CELL_W ? (HAR_CELL_W - w) / 2 : HAR_CELL_W - w;
+    int oy = (36 - h) / 2;
+    for(int y = 0; y < h; y++) {
+        for(int x = 0; x < w; x++) {
+            vga_pixel px = frame->data[(int)(y / scale) * frame->w + (int)(x / scale)];
+            if(ox + x >= 0 && px != frame->transparent) {
+                target->enabled.data[(oy + y) * HAR_CELL_W + ox + x] = px;
+            }
+        }
+    }
+}
